API_PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/resume_portal
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# AI provider: "groq" (hosted, fast, gpt-oss-120b) or "ollama" (local).
# Leave LLM_PROVIDER empty to use Groq when GROQ_API_KEY is set, otherwise Ollama.
LLM_PROVIDER=groq
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high: how long the model reasons before answering (higher = better but slower)
GROQ_REASONING_EFFORT=medium

# Local LLM (Ollama), used when LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Milliseconds to wait for one model response before using the rule-based fallback
# (defaults: 30000 for Groq, 90000 for Ollama)
LLM_TIMEOUT_MS=
