PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/resume_portal
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Local LLM (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Milliseconds to wait for a single Ollama response before using the fallback
OLLAMA_TIMEOUT_MS=90000
